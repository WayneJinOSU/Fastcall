# Use an official Python runtime as a parent image
FROM python:3.12-bullseye

# Set the working directory in the container
WORKDIR /app

# Copy dependency files for better Docker layer caching
COPY requirements.txt README.md ./

# Install dependencies using pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Preinstall NLTK sentence tokenizer data required by the TTS text aggregator
RUN python -m nltk.downloader punkt_tab

# Copy only the Agent runtime and its resources into the container
COPY main.py ./main.py
COPY src/collection_agents ./src/collection_agents
COPY assets ./assets
COPY templates ./templates

# Expose the desired port
EXPOSE 8765

# Run the application using uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8765"]
