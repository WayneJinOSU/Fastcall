# Existing local/external MySQL. No MySQL or SQLite container is created for Agent.
FASTCALL_DATABASE_URL=mysql+pymysql://fastcall:password@host.docker.internal:3306/fastcall
AGENT_DATABASE_URL=mysql+pymysql://agent:password@host.docker.internal:3306/collection_agents

# Internal Agent image tag (built by Compose), or set FASTCALL_AGENT_EXTERNAL=true for a host Agent.
COLLECTION_AGENT_IMAGE=collection-agent:stable
FASTCALL_AGENT_EXTERNAL=false

FASTCALL_SIP_ENABLED=true
FREESWITCH_EXTERNAL_IP=192.168.1.100
FREESWITCH_DOMAIN=
FREESWITCH_LOCAL_USER=8615908280801
FREESWITCH_LOCAL_PASSWORD=
FREESWITCH_WSS_PORT=7443
FREESWITCH_SIP_GATEWAY=

# Default SIP demo Robot providers. Fill in real credentials before starting calls.
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=
CARTESIA_API_KEY=

# Optional: reuse existing images or ports.
FASTCALL_IMAGE=fastcall:dev
FASTCALL_ADAPTER_IMAGE=fastcall-adapter:dev
FREESWITCH_IMAGE=fastcall-freeswitch:dev
FASTCALL_HTTP_PORT=8080
FASTCALL_HTTPS_PORT=8443
