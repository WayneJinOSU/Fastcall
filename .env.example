# ============================================================
# Collection Agents 环境变量模板
# 复制为 .env 后按需填写。所有项均为可选——未配置的集成会自动跳过。
# ============================================================

# ===== 运行模式 =====
# dev / test / prod
APP_ENV=dev
MODE=dev

# 服务启动时预热 Realtime/Deepgram/Cartesia WebSocket，降低首通连接延迟。
# 设为 0 可关闭。
STARTUP_PROVIDER_WARMUP=1
# 运行期间后台重新预热 Provider 连接的间隔；0 表示关闭周期预热。
STARTUP_PROVIDER_WARMUP_INTERVAL_SECS=900

# ===== LLM（默认：任意 OpenAI 兼容端点，可指向本地 vLLM/Ollama） =====
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY
# 使用 OpenRouter 时：
# OPENROUTER_API_KEY=
# 使用 DeepSeek 时：
# DEEPSEEK_API_KEY=
# 使用 Azure OpenAI 时（单端点配置）：
# AZURE_LLM_ENDPOINT=
# AZURE_LLM_API_KEY=
# AZURE_LLM_DEPLOYMENT=
# AZURE_LLM_API_VERSION=2025-04-01-preview

# ===== STT（默认 deepgram；可选 cartesia / elevenlabs / vosk 本地） =====
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# Vosk 本地模型路径（provider=vosk 时使用）：
# VOSK_MODEL_PATH=/path/to/vosk-model-small-es-0.42


# ===== 存储 =====
# 默认 SQLite：sqlite:///./data/collection_agents.db（零配置即用）
# 使用 MySQL 时：
# DATABASE_URL=mysql+pymysql://user:password@host:3306/collection_agents
# 仅开发调试需要双 ASR 对比时启用；生产环境默认关闭。
# ENABLE_ASR_SHADOW_COMPARE=0

# ===== Realtime Bot 资源 =====
# 通过环境变量配置单个 Azure Realtime 资源：
# AZURE_REALTIME_ENDPOINT=
# AZURE_REALTIME_MODEL=gpt-realtime-mini
# AZURE_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# AZURE_REALTIME_API_KEY=

# ===== 错误追踪（可选） =====
# SENTRY_DSN=

# ===== Robot Config Service（独立部署时以下四项必填） =====
# 每个 dev/test/prod 环境使用独立数据库和两个不同的 Token。
# ROBOT_CONFIG_DATABASE_URL=mysql+pymysql://user:password@host:3306/robot_config
# ROBOT_CONFIG_MANAGEMENT_TOKEN=
# ROBOT_CONFIG_RESOLVE_TOKEN=

