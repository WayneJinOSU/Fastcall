# ============================================================
# Collection Agents 环境变量模板
# 复制为 .env 后按需填写。所有项均为可选——未配置的集成会自动跳过。
# ============================================================

# ===== 运行模式 =====
# dev / test / prod
APP_ENV=dev
MODE=dev

# ===== LLM（默认：任意 OpenAI 兼容端点，可指向本地 vLLM/Ollama） =====
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY
# 使用 OpenRouter 时：
# OPENROUTER_API_KEY=
# 使用 DeepSeek 时：
# DEEPSEEK_API_KEY=
# 使用 Azure OpenAI 时（单端点配置）：
# AZURE_LLM_ENDPOINT=
# AZURE_LLM_API_KEY=
# AZURE_LLM_DEPLOYMENT=
# AZURE_LLM_API_VERSION=2025-04-01-preview

# ===== STT（默认 deepgram；可选 cartesia / elevenlabs / vosk 本地） =====
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# Vosk 本地模型路径（provider=vosk 时使用）：
# VOSK_MODEL_PATH=/path/to/vosk-model-small-es-0.42


# ===== 存储 =====
# 默认 SQLite：sqlite:///./data/collection_agents.db（零配置即用）
# 使用 MySQL 时：
# DATABASE_URL=mysql+pymysql://user:password@host:3306/collection_agents

# ===== 实时 Bot（realtime_alpha）资源 =====
# 通过环境变量配置单个 Azure Realtime 资源：
# AZURE_REALTIME_ENDPOINT=
# AZURE_REALTIME_MODEL=gpt-realtime-mini
# AZURE_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# AZURE_REALTIME_API_KEY=

# ===== 错误追踪（可选） =====
# SENTRY_DSN=

